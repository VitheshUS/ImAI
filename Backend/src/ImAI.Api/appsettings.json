{
  "Logging": {
    "File": {
      "Enabled": true,
      "Path": "logs/app-.jsonl",
      "AiChatPath": "logs/ai-chat-.jsonl",
      "FileSizeLimitBytes": 10485760,
      "RetainedFileCountLimit": 14
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConversationContext": {
    "SystemInstructions": "You are ImAI, an intelligent portfolio assistant."
  },
  "ConversationSummary": {
    "KLimit": 10
  }
}
